# --- env & secrets (NEVER commit real values) ---
.env
.env.*
!.env.example

# --- node ---
node_modules/

# --- build output ---
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# --- logs ---
logs/
*.log

# --- prisma generated client (regenerate: npm run db:generate) ---
prisma/generated/

# --- local scratch ---
.dev/
.DS_Store

# R2 spike tools (build via make -C tests/tools)
tests/tools/probe
tests/tools/tproxy-mini

# L3-C arm translator large binaries (hashes pinned in vendor/arm-translator/SOURCE.md)
vendor/arm-translator/*.zip
images/*/vendor/*.zip

# --- attest-app local caches (pinned Google Maven jars fetched by build.sh; APK force-added) ---
attest-app/build/
attest-app/libs/
attest-app/debug.keystore
images/*/patches/*.so
