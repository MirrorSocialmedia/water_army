<?xml version="1.0" encoding="utf-8"?>
<!-- EXP-3 (docs/l3-play-integrity.md §3.1) — Play Integrity / SafetyNet raw
     verdict collector. No UI: AttestActivity runs all probes on a worker
     thread, emits structured JSON to logcat tag WA-INTEGRITY and
     /data/local/tmp/wa-attest-result.json, then finishes. Failure paths
     (no GMS binding, missing classes, service errors) are recorded, never
     crash. Built offline via build.sh (aapt2/javac/d8/apksigner + pinned
     play-services jars in libs/). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.waterarmy.attest"
    android:versionCode="1"
    android:versionName="0.1-exp3">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="WA Attest">
        <!-- required by the GMS client handshake (status=10 without it); value mirrors
             play-services-basement 18.x @integer/google_play_services_version -->
        <meta-data android:name="com.google.android.gms.version" android:value="12451000" />
        <activity
            android:name=".AttestActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
