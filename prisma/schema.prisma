// water_army — Prisma schema (施工 MD §7 十表)
// Versioned migrations live in ./migrations (committed; MD §3: schema/migrations must be in repo).
// Regenerate client: npm run db:generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL moved out of the schema into prisma.config.js (CLI)
  // and the driver adapter (PrismaClient). See prisma.config.js + plugins/db.js.
}

// ---------------------------------------------------------------- users

enum Role {
  admin
  operator
  viewer
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String    @map("password_hash") // argon2id — never plaintext/reversible
  role         Role      @default(viewer)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  sessions Session[]

  @@map("users")
}

// ---------------------------------------------------------------- sessions
// Opaque token; only its SHA-256 hash is stored (MD §7 sessions).
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------- provider_configs
// encrypted_api_key = AES-256-GCM ciphertext (APP_ENCRYPTION_KEY, never in repo/DB plaintext path).
model ProviderConfig {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  providerType     String   @map("provider_type") // openai_compatible | webhook_agent
  baseUrl          String   @map("base_url")
  modelId          String?  @map("model_id")
  encryptedApiKey  String?  @map("encrypted_api_key")
  timeoutMs        Int      @default(120000) @map("timeout_ms")
  isEnabled        Boolean  @default(true) @map("is_enabled")
  capabilitiesJson Json?    @map("capabilities_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  taskDefinitions TaskDefinition[]

  @@map("provider_configs")
}

// ---------------------------------------------------------------- task_definitions
model TaskDefinition {
  id                String    @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  taskType          String    @default("ai") @map("task_type")
  providerConfigId  String    @map("provider_config_id") @db.Uuid
  promptTemplate    String    @map("prompt_template")
  mode              String    @default("analysis_only") // analysis_only | approved_tools
  inputSchemaJson   Json?     @map("input_schema_json")
  outputSchemaJson  Json?     @map("output_schema_json")
  timeoutMs         Int       @default(120000) @map("timeout_ms")
  maxAttempts       Int       @default(3) @map("max_attempts")
  concurrencyKey    String?   @map("concurrency_key")
  requiresApproval  Boolean   @default(false) @map("requires_approval")
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  providerConfig ProviderConfig @relation(fields: [providerConfigId], references: [id])
  runs           TaskRun[]
  schedules      Schedule[]

  @@index([providerConfigId])
  @@index([createdBy])
  @@map("task_definitions")
}

// ---------------------------------------------------------------- task_runs
enum TaskRunStatus {
  queued
  running
  needs_approval
  succeeded
  failed
  cancel_requested
  cancelled
  timed_out
  skipped
}

model TaskRun {
  id               String        @id @default(uuid()) @db.Uuid
  taskDefinitionId String?       @map("task_definition_id") @db.Uuid // nullable: ad-hoc runs
  scheduleId       String?       @map("schedule_id") @db.Uuid
  // Batch rotation (BR-B1, 施工 MD §9.4): batch/identity lineage (null = ad-hoc).
  batchId          String?       @map("batch_id") @db.Uuid
  identityId       String?       @map("identity_id") @db.Uuid
  // Lease + heartbeat (MD §6.2/§9.6): worker-owned execution lease.
  leaseOwner       String?       @map("lease_owner") // worker instance id (e.g. worker-abc123)
  leaseExpiresAt   DateTime?     @map("lease_expires_at")
  heartbeatAt      DateTime?     @map("heartbeat_at") // last worker heartbeat
  maxAttempts      Int           @default(3) @map("max_attempts") // columnized for batch runs (inputJson remains runtime source)
  status           TaskRunStatus @default(queued)
  inputJson        Json?         @map("input_json")
  resultJson       Json?         @map("result_json")
  resultText       String?       @map("result_text")
  errorCode        String?       @map("error_code")
  errorMessage     String?       @map("error_message")
  // BR-B3 (MD §9.4/§4.3): the Docker container this run owns (docker id after
  // create; null = not yet created / ad-hoc run). DB half of the double
  // ownership check — the container's water-army labels are the other half;
  // every lifecycle op requires BOTH to agree (CONTAINER_OWNERSHIP_MISMATCH
  // on disagreement). The lifecycle service owns writes; no UI mutates it.
  containerId      String?       @map("container_id")
  attempt          Int           @default(1)
  queuedAt         DateTime?     @map("queued_at")
  startedAt        DateTime?     @map("started_at")
  finishedAt       DateTime?     @map("finished_at") // terminal statuses only
  durationMs       Int?          @map("duration_ms")
  requestedBy      String?       @map("requested_by") @db.Uuid
  idempotencyKey   String?       @unique @map("idempotency_key") // unique within its scope (nullable = ad-hoc)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  taskDefinition TaskDefinition? @relation(fields: [taskDefinitionId], references: [id])
  events         TaskRunEvent[]
  batch          Batch?          @relation(fields: [batchId], references: [id])
  identity       Identity?       @relation(fields: [identityId], references: [id])

  // MD §7: status / created_at / schedule_id query indexes
  @@index([status])
  @@index([createdAt])
  @@index([scheduleId])
  @@index([taskDefinitionId])
  @@index([requestedBy])
  // Batch rotation (BR-B1): batch/identity lookup + lease expiry scanning
  @@index([batchId])
  @@index([identityId])
  @@index([leaseExpiresAt])
  @@index([containerId]) // BR-B3: reconcile reverse lookup (container → run)
  @@map("task_runs")
}

// ---------------------------------------------------------------- task_run_events
model TaskRunEvent {
  id        String   @id @default(uuid()) @db.Uuid
  taskRunId String   @map("task_run_id") @db.Uuid
  eventType String   @map("event_type") // queued/started/retry/approved/completed/failed/cancelled/timed_out
  message   String?
  payloadJson Json?  @map("payload_json") // secrets scrubbed before write
  createdAt DateTime @default(now()) @map("created_at")

  taskRun TaskRun @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  @@index([taskRunId, createdAt])
  @@map("task_run_events")
}

// ---------------------------------------------------------------- schedules
// PostgreSQL = single source of truth; BullMQ scheduler is the execution index (MD §12.1).
model Schedule {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @unique
  taskDefinitionId  String    @map("task_definition_id") @db.Uuid
  scheduleType      String    @map("schedule_type") // cron | interval
  cronExpression    String?   @map("cron_expression")
  intervalMs        Int?      @map("interval_ms")
  timezone          String    @default("Asia/Taipei") // IANA tz, per-schedule
  overlapPolicy     String    @default("skip_if_running") @map("overlap_policy") // skip_if_running | queue
  isEnabled         Boolean   @default(true) @map("is_enabled")
  nextRunAt         DateTime? @map("next_run_at")
  lastRunAt         DateTime? @map("last_run_at")
  lastStatus        String?   @map("last_status")
  bullmqSchedulerId String?   @unique @map("bullmq_scheduler_id")
  syncStatus        String    @default("synced") @map("sync_status") // synced | pending | sync_error
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  taskDefinition TaskDefinition @relation(fields: [taskDefinitionId], references: [id])

  @@index([isEnabled])
  @@index([taskDefinitionId])
  @@map("schedules")
}

// ---------------------------------------------------------------- approval_requests
model ApprovalRequest {
  id            String    @id @default(uuid()) @db.Uuid
  taskRunId     String    @map("task_run_id") @db.Uuid
  toolName      String    @map("tool_name")
  argumentsJson Json?     @map("arguments_json")
  status        String    @default("pending") // pending | approved | rejected | expired
  requestedAt   DateTime  @default(now()) @map("requested_at")
  reviewedBy    String?   @map("reviewed_by") @db.Uuid // real human user id — AI cannot self-approve
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String?   @map("review_note")

  @@index([taskRunId])
  @@index([status])
  @@map("approval_requests")
}

// ---------------------------------------------------------------- audit_events
// Destructive ops, template changes, provider changes, schedule changes,
// approve/reject and login failures all write here (MD §7/§13).
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String // e.g. auth.login_failed, container.stop, provider.update
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  ip           String?
  status       String? // success | failure
  detailsJson  Json?    @map("details_json") // secrets redacted before write
  createdAt    DateTime @default(now()) @map("created_at")

  // MD §7 audit query indexes
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

// ---------------------------------------------------------------- redroid_templates (P5, MD §7/§10)
// Dedicated, admin-curated Redroid templates. Privileged exists ONLY here
// (MD §9.2/§13.4 — a general app container can never be privileged).
// Image must be a pinned version — latest/nightly are rejected (MD §2.2).
model RedroidTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  image            String // pinned, e.g. redroid/redroid:15.0.0 (validated: explicit tag/digest, no latest/nightly)
  androidVersion   String   @map("android_version") // e.g. "15", "14"
  width            Int      @default(1080)
  height           Int      @default(1920)
  dpi              Int      @default(440)
  fps              Int      @default(30)
  gpuMode          String   @default("swiftshader_indirect") @map("gpu_mode") // swiftshader_indirect | host
  privileged       Boolean  @default(false)
  privilegedReason String?  @map("privileged_reason") // required when privileged=true — the explicit label (MD §9.2)
  isEnabled        Boolean  @default(true) @map("is_enabled")
  // Stage B (2026-10-19): optional fleet egress proxy, socks5://[user:pass@]host:port.
  // Stored ENCRYPTED (AES-256-GCM via @water-army/shared, same pattern as provider
  // api keys) — plaintext never touches the DB, API responses, or audit details.
  // Devices snapshot/override this at creation.
  proxyUrlEncrypted String? @map("proxy_url_encrypted")
  // R5: optional per-device resource limits (MD §7.2.7) — mapped to
  // HostConfig.NanoCpus / HostConfig.Memory at container create. Null =
  // unlimited (the honest default; limits are opt-in).
  cpuLimit         Float? @map("cpu_limit") // vCPU cap (e.g. 2 → NanoCpus 2000000000)
  memoryLimitBytes BigInt? @map("memory_limit_bytes") // RAM cap in bytes (e.g. 4 GiB)
  // W1 (2026-10-26, ADR-025): static Android-prop override baseline (JSONB map
  // prop→value, validated by validateRoOverridesMap). Default {} = today's
  // behaviour EXACTLY (zero-change). Applied at device create only when the
  // global switch WA_REDROID_RO_OVERRIDES_ENABLED=true — V3 real-device
  // verification is still open, so the switch stays OFF by design.
  roOverrides       Json     @default("{}") @map("ro_overrides")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  devices Device[]

  @@map("redroid_templates")
}

// ---------------------------------------------------------------- devices (P5)
// A Redroid Android test device. ADB port is unique on 127.0.0.1 (DB unique
// constraint; the bind address is fixed to 127.0.0.1 server-side, MD §2.3).
// width/height/dpi/fps/gpuMode/image are SNAPSHOTED from the template at
// creation — template edits never mutate a running device's contract.
model Device {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @unique
  templateId      String    @map("template_id") @db.Uuid
  adbPort         Int       @unique @map("adb_port") // published on 127.0.0.1 only
  dataDir         String    @map("data_dir") // dedicated host dir for /data (MD §10.2)
  containerName   String    @map("container_name")
  containerId     String?   @map("container_id") // docker id after create; null = provisioning failed
  image           String // snapshot of the template image at creation (deployment record, MD §10.2)
  androidVersion  String    @map("android_version")
  width           Int
  height          Int
  dpi             Int
  fps             Int
  gpuMode         String    @map("gpu_mode")
  containerState  String    @default("unknown") @map("container_state") // created|running|exited|paused|dead|missing|unknown
  adbState        String    @default("unknown") @map("adb_state") // online|offline|unknown
  gpuStatus       String    @default("unknown") @map("gpu_status") // unknown|unverified|software|verified — 未驗證 = 誠信核心
  // Stage B (2026-10-19): per-device egress proxy binding.
  // proxyUrlEncrypted = device-level override (null → fall back to template). Encrypted at rest.
  // gostPort = this device's dedicated gost container's host port (172.17.0.1, range
  // 20080–20179, DB-unique). null = no proxy configured.
  // proxyState machine: off → provisioning → running | stopped | error.
  proxyUrlEncrypted String? @map("proxy_url_encrypted")
  gostPort          Int?    @unique @map("gost_port")
  proxyState        String  @default("off") @map("proxy_state") // off|provisioning|running|stopped|error
  // R1 (2026-10-20): tun2socks binary diagnostic. Populated by the pre-provision
  // binary check (single staging point: /data/local/tmp/tun2socks).
  //   missing  — file absent (image built without the contract / container predates it)
  //   ready    — present, executable, valid ELF, --version canary passed
  //   invalid  — present but not executable / not ELF / canary failed (corruption)
  //   error    — the check itself could not be run (exec seam failure)
  // Never contains proxy credentials — state + version string only.
  binaryState   String? @map("binary_state")   // missing|ready|invalid|error
  binaryVersion String? @map("binary_version") // e.g. "tun2socks-2.7.0" (canary output, line 1)
  lastDiagnosedAt DateTime? @map("last_diagnosed_at")
  // R3 (2026-10-20): network health state — the fail-closed watchdog's
  // source of truth (survives container + API restarts). Written ONLY via
  // the audited persistNet() transition path. Never contains credentials.
  //   net_state: STOPPED|STARTING|VERIFYING|HEALTHY|DEGRADED|BLOCKED|FAILED
  //   net_next_recovery_at: persisted backoff anchor (next auto attempt
  //     may not start before it; null = no schedule)
  //   net_recovery_lock_owner/until: cross-process single-flight lease
  netState            String    @default("STOPPED") @map("net_state")
  netStateSince       DateTime? @map("net_state_since")
  netCheckedAt        DateTime? @map("net_checked_at")
  netLastSuccessAt    DateTime? @map("net_last_success_at")
  netConsecutiveFailures Int    @default(0) @map("net_consecutive_failures")
  netLastErrorCode    String?   @map("net_last_error_code")
  netLastErrorDetail  String?   @map("net_last_error_detail")
  netLastCanary       String?   @map("net_last_canary")
  netRecoveries       Int       @default(0) @map("net_recoveries")
  netLastRecoveryAt   DateTime? @map("net_last_recovery_at")
  netNextRecoveryAt   DateTime? @map("net_next_recovery_at")
  netManualIntervention Boolean @default(false) @map("net_manual_intervention")
  netRecoveryLockOwner  String?  @map("net_recovery_lock_owner")
  netRecoveryLockUntil  DateTime? @map("net_recovery_lock_until")
  // R4 (MD §6.2): per-check breakdown of the LAST verification pass — flat
  // machine-readable status values only (zero secrets; no proxy URL ever).
  netLastChecks     Json?     @map("net_last_checks")
  // W1 (2026-10-26, ADR-025): identity fingerprint binding. identityId = the
  // identity this device boots AS (null = unbound — today's behaviour).
  // roOverridesJson = the EXACT merged prop map injected at create (audit /
  // recreate-stability evidence). Both only populated when the W1 switch is
  // ON at create time; SetNull keeps device history when identity is deleted.
  identityId        String?   @map("identity_id") @db.Uuid
  roOverridesJson   Json      @default("{}") @map("ro_overrides_json")
  // W3 (2026-10-26, ADR-027): identity-level PINNED EGRESS state machine.
  // Written ONLY via the audited persistEgress() transition path (the egress
  // twin of persistNet). Inert while WA_W3_EGRESS_BINDING_ENABLED is OFF
  // (default): egress_state stays 'UNCHECKED' and the dispatch gate ignores
  // it. egress_last_observed_ip = the OBSERVED exit IP (egress metadata, not
  // a credential — a proxy URL never touches these columns).
  egressState           String    @default("UNCHECKED") @map("egress_state") // UNCHECKED|VERIFIED|DRIFTED|UNREACHABLE|NO_PROXY|UNBOUND
  egressStateSince      DateTime? @map("egress_state_since")
  egressCheckedAt       DateTime? @map("egress_checked_at")
  egressLastMatchAt     DateTime? @map("egress_last_match_at")
  egressConsecutiveFailures Int   @default(0) @map("egress_consecutive_failures")
  egressLastErrorCode   String?   @map("egress_last_error_code")
  egressLastObservedIp  String?   @map("egress_last_observed_ip")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  template     RedroidTemplate @relation(fields: [templateId], references: [id])
  identity     Identity?       @relation("DeviceIdentity", fields: [identityId], references: [id], onDelete: SetNull)
  streamLeases StreamLease[]   // MC P1 (Mobile Console MD §8.1/§4.1)
  interventions ManualIntervention[] // MC P4 (Mobile Console MD Phase 4 / §6)

  @@index([templateId])
  @@index([containerState])
  @@index([identityId])
  @@map("devices")
}

// ---------------------------------------------------------------- P6: schedule notifications
// One row per terminal scheduled run (flag #3 — MD 尾段: 排程執行完成/失敗 → UI 通知).
// Unique on run_id (a run notifies at most once, terminal is one-way).
model ScheduleNotification {
  id         String   @id @default(cuid()) @db.Text
  scheduleId String   @map("schedule_id") @db.Text
  runId      String   @unique @map("run_id") @db.Text
  status     String // terminal run status: succeeded|failed|timed_out|cancelled|skipped
  title      String
  message    String? // error code/summary, scrubbed
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([scheduleId])
  @@index([isRead, createdAt])
  @@map("schedule_notifications")
}

// ---------------------------------------------------------------- identities (BR-B1, MD §9.1)
// One row per approved test identity (200 total in the default cycle). The
// row is the STABLE anchor — purge_identity_data (MD §4.2) removes the data
// volume, never this row.
// metadataJson MUST NOT hold passwords/cookies/tokens (MD §9.1) — secrets go
// through the existing encryption path; the service layer rejects a
// credential-shaped key set before write (see batch-service sanitizeMetadata).
model Identity {
  id           String   @id @default(uuid()) @db.Uuid
  externalRef  String?  @unique @map("external_ref") // operator-supplied stable ref, e.g. "qa-042"
  displayName  String   @map("display_name")
  identityType String   @map("identity_type") // registry allowlist: qa_device | staging_user
  status       String   @default("READY") // DISABLED|READY|RESERVED|RUNNING|CANCELLING|COMPLETED|RETRY_WAIT|RECOVERING|FAILED_FINAL|CANCELLED|SKIPPED
  dataPath     String   @unique @map("data_path") // canonical host dir, UNIQUE = no two identities share a writable path (MD §4.1)
  metadataJson Json     @default("{}") @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  batchMemberships BatchIdentity[]
  runs               TaskRun[]
  // W1 (ADR-025): 1:1 fingerprint profile + devices currently bound to this identity.
  fingerprintProfile IdentityFingerprint?
  devices            Device[]        @relation("DeviceIdentity")
  // W3 (ADR-027): 1:1 pinned egress binding (proxy + expected egress IP).
  egressBinding IdentityEgress?

  @@index([status])
  @@index([identityType])
  @@map("identities")
}

// ------------------------------------------------- identity fingerprints (W1)
// Identity-level device fingerprint profile (ADR-025). Generated DETERMINISTIC
// from the identityId (packages/shared fingerprint-profile.js) — the row is a
// materialised snapshot, regeneration is idempotent by construction.
// profileJson is the single truth; the typed columns exist for the DB-unique
// guards (fingerprint/serial/displayId = fail-closed collision enforcement
// across the fleet) and cheap joins. NOT VERIFIED on real devices (V3) — the
// profile is code-level truth until the ADR-025 getprop matrix passes.
model IdentityFingerprint {
  identityId    String   @id @map("identity_id") @db.Uuid
  profileJson   Json     @map("profile_json")
  brand         String
  model         String
  device        String
  productName   String   @map("product_name")
  manufacturer  String
  androidRelease String  @map("android_release")
  buildId       String   @map("build_id")
  displayId     String   @unique @map("display_id")
  fingerprint   String   @unique
  serial        String   @unique
  locale        String
  timezone      String
  carrierName   String   @map("carrier_name")
  carrierMcc    String   @map("carrier_mcc")
  carrierMnc    String   @map("carrier_mnc")
  schemaVersion Int      @default(1) @map("schema_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([brand, model])
  @@map("identity_fingerprints")
}

// ------------------------------------------------- identity egress (W3)
// Identity-level PINNED EGRESS (ADR-027): the one egress expectation per
// identity. proxyUrlEncrypted = AES-256-GCM ciphertext (same codec as the
// Stage B redroid proxy URLs — decryptable with APP_ENCRYPTION_KEY; the W3
// runtime path NEVER decrypts: presence is `!= null`, and the in-device
// probe only ever learns the observed exit IP). expectedEgressIp is the
// single exit IP this identity is allowed to exit from — DB-unique across
// the fleet (two identities sharing an exit IP = correlation, the exact
// failure W3 exists to catch). proxyUrlHash = sha256(plaintext URL),
// one-way: change detection for the "binding changed → re-verify all bound
// devices" reset; preimage resistant, safe to expose in API views.
// firstVerifiedAt/lastVerifiedAt = fleet-level verification freshness for
// this binding (updated by the verify path on a fresh match).
model IdentityEgress {
  identityId       String   @id @map("identity_id") @db.Uuid
  proxyUrlEncrypted String  @map("proxy_url_encrypted")
  proxyUrlHash     String   @map("proxy_url_hash")
  expectedEgressIp String   @unique @map("expected_egress_ip")
  schemaVersion    Int      @default(1) @map("schema_version")
  firstVerifiedAt  DateTime? @map("first_verified_at")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("identity_egress_bindings")
}

// ---------------------------------------------------------------- batches (BR-B1, MD §9.2)
// One cycle = one full rotation over all identities (default 200 → 4×50).
// cycleId + batchNo is unique: a cycle can never contain two "batch 2" rows.
// idempotencyKey: POST /api/batches requires it (MD §10) — replays return
// the original cycle, never a second one.
model Batch {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  cycleId             String    @map("cycle_id") // stable per planning run (uuid)
  batchNo             Int       @map("batch_no") // 1-based, ascending = execution order (MD §3.2)
  status              String    @default("PLANNED") // PLANNED|RUNNING|PAUSED|CANCELLING|COMPLETED|COMPLETED_WITH_ERRORS|CANCELLED
  batchSize           Int       @map("batch_size") // actual membership count for this batch
  maxActiveContainers Int       @map("max_active_containers") // per-batch cap; global cap is min(batch cap, AppSetting, host budget) (MD §3.1)
  failurePolicy       String    @map("failure_policy") // stop_batch | continue_and_report (MD §3.3)
  configJson          Json      @default("{}") @map("config_json") // inter_batch_cooldown_seconds, timeouts, adapter, ...
  idempotencyKey      String?   @unique @map("idempotency_key")
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  startedAt           DateTime? @map("started_at")
  finishedAt          DateTime? @map("finished_at")

  identities BatchIdentity[]
  runs       TaskRun[]

  @@unique([cycleId, batchNo])
  @@index([status])
  @@index([cycleId])
  @@map("batches")
}

// ---------------------------------------------------------------- batch_identities (BR-B1, MD §9.3)
// Position is the identity's slot WITHIN this batch (1-based). Disabled
// identities occupy their position with status=SKIPPED + skipReason (MD §3.2:
// never silently rebind other identities).
model BatchIdentity {
  batchId    String   @map("batch_id") @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  position   Int // 1-based order inside the batch
  status     String   @default("PENDING") // PENDING|ACTIVE|COMPLETED|FAILED_FINAL|CANCELLED|SKIPPED — mirrors the identity FSM terminal set
  skipReason String?  @map("skip_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([batchId, identityId])
  @@unique([batchId, position])
  @@index([identityId])
  @@map("batch_identities")
}

// ---------------------------------------------------------------- resource_leases (BR-B1, MD §9.6)
// Cross-process leases for: container slots (resource_key 'slot-0'..'slot-N'),
// host ports (if host-port ADB workflows return) and identity reservations.
// CAS semantics live in lease-service.js: create (P2002 → refetch) + expired
// takeover via single-statement updateMany(lease_expires_at <= now) — the
// loser's update matches 0 rows. No table is ever dropped at boot (MD §9.6).
model ResourceLease {
  id             String   @id @default(uuid()) @db.Uuid
  resourceType   String   @map("resource_type") // container_slot | port | identity_reservation
  resourceKey    String   @map("resource_key") // e.g. "slot-7", "172.17.0.1:20080", identity uuid
  ownerRunId     String?  @map("owner_run_id") @db.Uuid // the task run holding the lease (null allowed at acquire, bound at start)
  ownerLabel     String?  @map("owner_label") // worker instance id (ops/reconciliation visibility)
  leaseExpiresAt DateTime @map("lease_expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([resourceType, resourceKey])
  @@index([leaseExpiresAt])
  @@index([ownerRunId])
  @@map("resource_leases")
}

// ---------------------------------------------------------------- stream_leases (MC P1, Mobile Console MD §4.1/§8.1)
// Per-viewer-session stream leases for the 5-screen redroid console.
//
// Design (ADR-019 §19.11):
//  - PG is the source of truth (Redis is coordination-only: ticket single-use).
//  - GLOBAL slot (0..MAX-1) is claimed atomically through the existing
//    resource_leases table (resourceType='stream_slot', this lease's own id as
//    ownerRunId) via createLeaseService.acquireSlot — the DB unique constraint
//    is the race guard; there is NO count-then-insert path (MD §4.1).
//  - ONE active lease per device (MVP-strict, MD §4.1 allows "每設備一個 viewer
//    session"): enforced by the PARTIAL UNIQUE INDEX below (status in
//    PENDING/ACTIVE) — the 2nd concurrent acquire on the same device gets a
//    23505 → STREAM_DEVICE_HELD (409), exactly one winner.
//  - version = CAS counter. Every transition (heartbeat / close / expire /
//    interrupt) is a single-statement updateMany carrying the expected
//    version (and status) — a concurrent winner bumps the version and the
//    loser matches 0 rows (MD §4.1: owner/version 條件防誤刪新 lease).
//  - lastHeartbeatAt/expiresAt are SERVER time only (MD §4.1: 客戶端時間不能
//    決定 lease 是否過期).
//  - status: PENDING (acquiring slot) → ACTIVE → CLOSED | EXPIRED | INTERRUPTED.
//    INTERRUPTED = set at API restart reconciliation (the issuing process died
//    → its streams are dead; MD §10: cannot assume the stream is still alive).
model StreamLease {
  id              String    @id @default(uuid()) @db.Uuid
  deviceId        String    @map("device_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  mode            String // viewer | controller (MD §8.1)
  status          String    @default("PENDING") // PENDING|ACTIVE|CLOSED|EXPIRED|INTERRUPTED
  version         Int       @default(1) // CAS counter (MD §4.1 owner/version 條件)
  slotIndex       Int?      @map("slot_index") // global slot 0..MAX-1; set at PENDING→ACTIVE, nulled at terminal
  createdAt       DateTime  @default(now()) @map("created_at")
  lastHeartbeatAt DateTime  @map("last_heartbeat_at") // server time
  expiresAt       DateTime  @map("expires_at") // server time; heartbeat extends
  closedAt        DateTime? @map("closed_at")
  closeReason     String?   @map("close_reason") // user_closed|expired|api_restart|device_deleted|denied
  correlationId   String?   @map("correlation_id") // requestId that created the lease
  updatedAt       DateTime  @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([status, expiresAt]) // expiry reconcile sweep
  @@index([userId])
  @@map("stream_leases")
}

// ---------------------------------------------------------------- state_events (BR-B1, MD §9.5)
// Append-only from/to state event store, GENERIC over entity type
// (identity | batch | task_run | lease). Kept separate from task_run_events
// on purpose: (a) task_run_events cascade-delete with the run, while
// identity/batch state outlives runs; (b) MD §9.5 asks for entity
// type/ID + correlation id, which a run-scoped table cannot carry.
// Append-only is enforced at the service layer (same convention as
// audit_events — this repo has no DB triggers): there is NO API surface
// that updates or deletes these rows.
model StateEvent {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String   @map("entity_type") // identity | batch | task_run | lease
  entityId      String   @map("entity_id")
  fromState     String?  @map("from_state") // null = birth event
  toState       String   @map("to_state")
  reason        String? // human-readable, scrubbed (MD §9.5)
  actor         String? // user uuid | 'worker:<label>' | 'scheduler' | 'system'
  correlationId String?  @map("correlation_id") // groups a causal chain (cycle id / batch id / request id)
  detailsJson   Json?    @map("details_json") // secrets scrubbed before write
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([correlationId])
  @@index([toState])
  @@map("state_events")
}

// ---------------------------------------------------------------- app_settings
// Non-sensitive system settings only; sensitive keys via app-layer encryption or env secrets.
model AppSetting {
  key        String   @id // e.g. redroid.default_template, ui.default_timezone
  valueJson  Json     @map("value_json")
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ---------------------------------------------------------------- manual_interventions (MC P4, Mobile Console MD §6)
// Human-intervention event — the durable, queryable record of a stuck/
// needs-review device (or task). NOT the source of truth for device state
// (that stays on devices.net_* / adb_state / container_state); this is the
// notification + audit + lifecycle surface on top of the reliable signals.
//
// Episode / dedupe (MD §6.3):
//   - ONE open episode per device+category+source, guarded at the DB level by
//     the PARTIAL UNIQUE INDEX manual_interventions_dedupe_open_ux
//     (dedupeKey WHERE status IN open/acknowledged/in_progress). A repeat
//     signal re-escalates the open episode (signalCount++, severity/disposition
//     only go UP) instead of a notification storm.
//   - resolved/dismissed leave the partial-unique window, so a LATER signal
//     creates a NEW episode — a stale late signal can NEVER auto-reopen a
//     terminal event (MD §6.3). Reopening is only the explicit operator
//     `reopen` transition (version-guarded, audited).
//
// automationDisposition (MD §6.2): third-party CAPTCHA / anti-bot /
//   account-integrity challenges MUST be 'blocked_pending_review' and are
//   NEVER auto-resolved or used to auto-resume batch automation (MD §0.6).
//
// Secrets: title/summary/evidence are scrubbed (scrubObject) before write;
//   evidence holds only redacted summaries + event ids + error codes — never
//   screen pixels, full logcat, cookies, passwords or proxy URLs (MD §6.2/§13).
//
// version = CAS counter (MD §6.2/§9.6 style): every operator transition is a
//   single-statement updateMany carrying the expected version + status, so a
//   concurrent winner bumps the version and the loser matches 0 rows.
model ManualIntervention {
  id                    String    @id @default(uuid()) @db.Uuid
  // Nullable FK (onDelete SetNull): when the device row is removed the event
  // is KEPT and still readable via deviceNameSnapshot (MD §6.2).
  deviceId              String?   @map("device_id") @db.Uuid
  deviceNameSnapshot    String?   @map("device_name_snapshot") // human-readable, survives device delete
  source                String // container_health|adb_health|boot_timeout|app_crash|qa_signal|network_state|operator_report|external_verification
  category              String // DEVICE_OFFLINE|BOOT_TIMEOUT|APP_CRASH|APP_UNRESPONSIVE|PERMISSION_REQUIRED|MANUAL_REVIEW|NETWORK_BLOCKED|EXTERNAL_VERIFICATION|TASK_FAILED|OTHER
  severity              String    @default("warning") // info|warning|high|critical
  status                String    @default("open") // open|acknowledged|in_progress|resolved|dismissed
  automationDisposition String    @default("not_applicable") @map("automation_disposition") // not_applicable|paused|blocked_pending_review
  title                 String
  summary               String?
  evidence              Json? // redacted only (no pixels/logcat/secrets)
  // true = heuristic signal (logcat signature etc.) — UI must label it and
  // allow the operator to confirm / false-positive it (MD §6.1).
  heuristic             Boolean   @default(false)
  // How many times the source fired within this open episode (dedupe counter).
  signalCount           Int       @default(1) @map("signal_count")
  // CAS counter for the state machine (MD §6.2/§9.6).
  version               Int       @default(1)
  // Terminal-state operator note (resolve summary OR dismiss reason — both
  // required by their routes; the column is shared). No secrets (scrubbed).
  resolutionSummary     String?   @map("resolution_summary")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  acknowledgedAt        DateTime? @map("acknowledged_at")
  resolvedAt            DateTime? @map("resolved_at") // set on resolve OR dismiss (terminal timestamp)
  assigneeUserId        String?   @map("assignee_user_id") @db.Uuid // nullable; the operator who owns handling
  dedupeKey             String    @map("dedupe_key")
  relatedTaskRunId      String?   @map("related_task_run_id") @db.Uuid // nullable; ownership/scope checked by the caller

  device    Device?                  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  history   ManualInterventionHistory[]

  @@index([status, severity, updatedAt]) // MD §9 suggested index
  @@index([deviceId, status, category]) // MD §9 suggested index
  @@index([assigneeUserId])
  @@map("manual_interventions")
}

// Partial unique: ONE open episode per dedupeKey (MD §6.3 race guard). Terminal
// rows (resolved/dismissed) are outside the window, so a new signal after a
// terminal state creates a fresh episode (never auto-reopens the old one).
// (Applied in the migration SQL — Prisma cannot express partial indexes.)

// ---------------------------------------------------------------- manual_intervention_history (MC P4)
// Append-only transition/audit trail for one intervention (MD §6.2: "另建
// audit/history 記錄狀態轉換及操作者"). Kept separate from audit_events so an
// operator can pull a single event's full story in one join; the same
// transitions ALSO write audit_events (operator + request context). No API
// surface updates or deletes these rows (append-only convention, like
// state_events).
model ManualInterventionHistory {
  id              String   @id @default(uuid()) @db.Uuid
  interventionId  String   @map("intervention_id") @db.Uuid
  fromStatus      String?  @map("from_status") // null = birth (created)
  toStatus        String   @map("to_status")
  action          String // created|signal|acknowledged|assigned|resolved|dismissed|reopened
  actorUserId     String?  @map("actor_user_id") @db.Uuid // null = system signal
  note            String? // short, scrubbed
  detailsJson     Json?    @map("details_json") // scrubbed
  createdAt       DateTime @default(now()) @map("created_at")

  intervention ManualIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId, createdAt])
  @@map("manual_intervention_history")
}
