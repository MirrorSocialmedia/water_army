    exec -- /vendor/bin/oem-propctl ro.product.product.brand ${ro.boot.oem_ro_product_product_brand}
on early-init && property:ro.boot.oem_ro_product_product_device=*
    exec -- /vendor/bin/oem-propctl ro.product.product.device ${ro.boot.oem_ro_product_product_device}
