# carrier sweep — runs strictly after all write blocks above (file order)
on early-init
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_product_brand
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_build_id
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_product_device
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_build_display_id
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_build_fingerprint
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_boot_hardware
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_hardware
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_product_manufacturer
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_product_model
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_product_name
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_serialno
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_board_platform
    exec -- /vendor/bin/oem-propctl --delete-if-exist ro.boot.oem_ro_build_description
