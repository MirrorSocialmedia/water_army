# water_army WA-VMSTEALTH — carrier -> ro.*/persist.* mapping + stealth props + carrier sweep (GENERATED — do not hand-edit)
# regenerate: node scripts/w1b/generate-wa-ro-map-rc.mjs --stealth
# source of truth: packages/shared/src/w1b-image-mapping.js + fingerprint-profile.js (unit-diffed in CI)
#
# Same semantics as the base W1b rc (see generateWaRoMapRc header) plus:
# - stealth: derived build props (ro.build.flavor/description/…, the five
#   ro.product.<partition>.* variant sets and ro.<partition>.build.* tags/
#   incremental/fingerprints, ro.product.board/ro.board.platform) ride the
#   same verified carrier chain — the redroid build-prop tell dies with them
#   (docs/audits/vmstealth-s1-mechanism.md §4).
# - sweep: after every write of a phase has run, each still-present
#   ro.boot.oem_* carrier is deleted (--delete-if-exist = absent-safe).

on early-init && property:ro.boot.oem_ro_product_brand=*
    exec -- /vendor/bin/oem-propctl ro.product.brand ${ro.boot.oem_ro_product_brand}
on early-init && property:ro.boot.oem_ro_build_id=*
    exec -- /vendor/bin/oem-propctl ro.build.id ${ro.boot.oem_ro_build_id}
on early-init && property:ro.boot.oem_ro_product_device=*
    exec -- /vendor/bin/oem-propctl ro.product.device ${ro.boot.oem_ro_product_device}
on early-init && property:ro.boot.oem_ro_build_display_id=*
    exec -- /vendor/bin/oem-propctl ro.build.display.id ${ro.boot.oem_ro_build_display_id}
on early-init && property:ro.boot.oem_ro_build_fingerprint=*
    exec -- /vendor/bin/oem-propctl ro.build.fingerprint ${ro.boot.oem_ro_build_fingerprint}
on early-init && property:ro.boot.oem_ro_boot_hardware=*
    exec -- /vendor/bin/oem-propctl ro.boot.hardware ${ro.boot.oem_ro_boot_hardware}
on early-init && property:ro.boot.oem_ro_hardware=*
    exec -- /vendor/bin/oem-propctl ro.hardware ${ro.boot.oem_ro_hardware}
on early-init && property:ro.boot.oem_ro_product_manufacturer=*
    exec -- /vendor/bin/oem-propctl ro.product.manufacturer ${ro.boot.oem_ro_product_manufacturer}
on early-init && property:ro.boot.oem_ro_product_model=*
