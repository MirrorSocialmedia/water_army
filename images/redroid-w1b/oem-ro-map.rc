# water_army W1b — carrier -> ro.*/persist.* mapping (GENERATED — do not hand-edit)
# regenerate: node scripts/w1b/generate-wa-ro-map-rc.mjs
# source of truth: packages/shared/src/w1b-image-mapping.js (unit-diffed in CI)
#
# load_persist_props_action: for every androidboot.oem_* carrier present on
# the kernel cmdline (init exposes them as ro.boot.oem_*), rewrite the REAL
# ro.*/persist.* prop via the writer binary below. The phase is AFTER init.rc
# re-asserts build.prop defaults + re-initialises the persist area (fresh /data
# wipes earlier writes — S6 on-device), and still strictly before zygote and
# class_start core, so no consumer sees defaults. Absent carrier = no action.
# load_persist_props_action: persist.* targets (timezone) map HERE via the
# stock setprop (resetprop-rs cannot write persist.* — real-device,
# WA-OEMPROP S3), not in early-init/post-fs-data: init.rc loads stored
# persistent properties from /data/property via `load_persist_props` inside
# its own `on post-fs-data` section and then fires this trigger. Mapping on
# the trigger is the ordering-guaranteed hook; it still fires strictly
# before zygote reads persist.sys.timezone.
# early-init keeps only non-ro/non-persist targets (net.hostname — init
# consumes it during `on init`; debug.sf.* — no build.prop default to re-assert).

on load_persist_props_action && property:ro.boot.oem_ro_product_brand=*
    exec -- /vendor/bin/oem-propctl ro.product.brand ${ro.boot.oem_ro_product_brand}
on load_persist_props_action && property:ro.boot.oem_ro_build_id=*
    exec -- /vendor/bin/oem-propctl ro.build.id ${ro.boot.oem_ro_build_id}
on load_persist_props_action && property:ro.boot.oem_ro_product_device=*
    exec -- /vendor/bin/oem-propctl ro.product.device ${ro.boot.oem_ro_product_device}
on load_persist_props_action && property:ro.boot.oem_ro_build_display_id=*
    exec -- /vendor/bin/oem-propctl ro.build.display.id ${ro.boot.oem_ro_build_display_id}
on load_persist_props_action && property:ro.boot.oem_ro_build_fingerprint=*
    exec -- /vendor/bin/oem-propctl ro.build.fingerprint ${ro.boot.oem_ro_build_fingerprint}
on load_persist_props_action && property:ro.boot.oem_ro_boot_hardware=*
    exec -- /vendor/bin/oem-propctl ro.boot.hardware ${ro.boot.oem_ro_boot_hardware}
on load_persist_props_action && property:ro.boot.oem_ro_hardware=*
    exec -- /vendor/bin/oem-propctl ro.hardware ${ro.boot.oem_ro_hardware}
on load_persist_props_action && property:ro.boot.oem_ro_product_locale=*
    exec -- /vendor/bin/oem-propctl ro.product.locale ${ro.boot.oem_ro_product_locale}
on load_persist_props_action && property:ro.boot.oem_ro_product_manufacturer=*
    exec -- /vendor/bin/oem-propctl ro.product.manufacturer ${ro.boot.oem_ro_product_manufacturer}
on load_persist_props_action && property:ro.boot.oem_ro_product_model=*
    exec -- /vendor/bin/oem-propctl ro.product.model ${ro.boot.oem_ro_product_model}
on load_persist_props_action && property:ro.boot.oem_ro_product_name=*
    exec -- /vendor/bin/oem-propctl ro.product.name ${ro.boot.oem_ro_product_name}
on load_persist_props_action && property:ro.boot.oem_ro_serialno=*
    exec -- /vendor/bin/oem-propctl ro.serialno ${ro.boot.oem_ro_serialno}
on load_persist_props_action && property:ro.boot.oem_persist_sys_timezone=*
    exec -- /system/bin/setprop persist.sys.timezone ${ro.boot.oem_persist_sys_timezone}
