# =============================================================================
# water_army — environment template (施工 MD §14)
# Copy to .env and replace ALL placeholders. Never commit .env.
#   cp .env.example .env
# Generate secrets:  openssl rand -hex 32   (64 hex chars)
# =============================================================================

# --- Runtime ---
NODE_ENV=production
# Host-local dev binds loopback only. Inside the compose network the api
# container must bind all interfaces because the web container proxies
# /api -> api:3000 (the host never exposes the api port).
APP_HOST=127.0.0.1
APP_PORT=3000
# Public origin of the web UI (used for CSRF/Origin allowlist).
APP_PUBLIC_URL=http://127.0.0.1:3012
# The api sits behind the web reverse proxy, which overwrites X-Forwarded-For
# with the real client IP; trusting it makes login rate limiting per-client.
# Set to false ONLY if you expose the api directly (no proxy in front).
#TRUST_PROXY=true

# --- Secrets ---
# APP_ENCRYPTION_KEY: provider API key encryption (AES-256-GCM). The SAME key
# is passed to api + worker (the worker decrypts locally; keys never cross
# the queue). Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS
# SESSION_SECRET: session token hashing / signing.
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
# WORKER_API_TOKEN: service identity for worker→API tool calls (>=32 chars).
# Must match in BOTH the api and worker compose env. Generate:
#   openssl rand -hex 32
WORKER_API_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARS

# --- Session ---
SESSION_TTL_HOURS=12
# Set true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- PostgreSQL (compose postgres service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_HEX_CHARS
POSTGRES_DB=water_army
# Inside compose: host is `postgres`. Host-local dev: point at your own instance.
DATABASE_URL=postgresql://app:REPLACE_WITH_RANDOM_32_HEX_CHARS@postgres:5432/water_army

# --- Redis / queue ---
REDIS_URL=redis://redis:6379

# --- Docker ---
# ONLY the api service mounts this socket (read-only). Worker/web never see it.
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Local dev without Docker: set to empty string to disable the Docker check
# (health/ready will report docker: disabled instead of down).
#DOCKER_SOCKET_PATH=
# gid of the host's docker group — the api container (USER node) needs it to
# rw the socket. Check with: stat -c %g /var/run/docker.sock
DOCKER_GROUP_ID=125

# --- Task defaults (施工 MD 附錄 A) ---
DEFAULT_TIMEZONE=Asia/Taipei
TASK_DEFAULT_TIMEOUT_MS=120000
TASK_MAX_TIMEOUT_MS=900000
TASK_DEFAULT_ATTEMPTS=3
TASK_MAX_CONCURRENCY=4
# P6 flag #5: concurrency_key mutual exclusion — a job whose definition shares
# a concurrency_key with an in-flight run defers (15s × 10 = 2.5 min max hold),
# then records a visible `skipped` run instead of running in parallel.
TASK_CONCURRENCY_DEFER_MS=15000
TASK_CONCURRENCY_MAX_DEFERS=10
# Default AI provider when POST /api/tasks/runs omits body.provider.
# 'mock' = built-in orchestratable mock; or a name from /api/providers.
AI_PROVIDER=mock
# Mock provider script: built-in name (default | tool-docker-list |
# tool-restart-approve | slow | fail-then-ok | fail-auth | empty),
# a file path, or inline JSON (see apps/worker/src/providers/mock.js).
AI_MOCK_SCRIPT=default
# Inside compose the worker reaches the api at http://api:3000.
API_INTERNAL_URL=http://api:3000

# --- Web container (static server + /api proxy) ---
WEB_PORT=3012
API_UPSTREAM=http://api:3000

# --- Network policy (施工 MD §5.1/§12, BR-B4) ---
# QA endpoint allowlist — comma-separated EXACT entries; NO wildcards, paths or
# credentials. Format: https://host[:port] or http://host[:port] (bare
# host[:port] = https). Port defaults: 443 (https) / 80 (http).
# PUBLIC zone — every resolved IP of these hosts must be a PUBLIC address:
# loopback / private / link-local / CGNAT / metadata (169.254.169.254) /
# unspecified are rejected (SSRF, fail-closed). DNS is resolved ONCE per
# dispatch and ALL returned addresses are validated (anti-rebinding).
# INTERNAL zone — Docker-network / host-local egress targets (e.g. the API
# itself): these must resolve to loopback / private / link-local addresses;
# the metadata endpoint is rejected in BOTH zones.
# While NO valid entry exists (env or appSetting), the policy is UNAVAILABLE
# and EVERY task run is denied (fail-closed — never falls back to allow-all).
# Admin-only runtime edits: appSetting keys network.qaEndpointAllowlist /
# network.qaEndpointAllowlistInternal / network.taskTypePolicy (MD §12) —
# full design: docs/network-policy.md.
QA_ENDPOINT_ALLOWLIST=
QA_ENDPOINT_ALLOWLIST_INTERNAL=

# --- Redroid (施工 MD §7/§10；只列程序真讀嘅變數，MD §9.1 規則) ---
# Adapter: 'real' (production-forced) or 'mock' (deterministic test adapter).
REDROID_ADAPTER=real
# Per-device /data root on the host (compose volume -> api container). The api
# runs uid 1000; the dir must exist + be writable by it (runbook §9).
REDROID_DATA_ROOT=/var/lib/water-army/redroid
# adb binary path on the api host (whitelist engine; 127.0.0.1-only bind).
REDROID_ADB_BINARY=/usr/bin/adb
# ADB host-port allocation range (devices only; server-side enforced).
REDROID_ADB_RANGE_START=15000
REDROID_ADB_RANGE_END=15999
# ADB operation timeout + output cap (bytes).
REDROID_ADB_TIMEOUT_MS=20000
REDROID_ADB_MAX_OUTPUT=262144
# logcat: default tail lines + server-side hard cap (GET ?tail is clamped).
REDROID_LOGCAT_TAIL_DEFAULT=200
REDROID_LOGCAT_TAIL_MAX=5000
# host preflight (kernel/docker/data-root checks) timeout + output cap.
REDROID_PREFLIGHT_TIMEOUT_MS=5000
REDROID_PREFLIGHT_MAX_OUTPUT=65536
# create idempotency replay window (ms).
REDROID_IDEMPOTENCY_TTL_MS=600000
# network health watchdog: verify poll interval + HEALTHY-stale threshold.
REDROID_HEALTH_POLL_MS=30000
REDROID_HEALTH_STALE_MS=60000
# in-device netcheck script timeout (ms).
REDROID_NETCHECK_TIMEOUT_MS=20000
# boot_completed wait during tunnel provision (ms). R6-calibrated 40min:
# real cold/recreate boots take ~24min (R5 live evidence); fast hosts may
# lower it. Timeout -> netState FAILED (TUNNEL_START_TIMEOUT) + 504.
REDROID_TUNNEL_BOOT_TIMEOUT_MS=2400000
# boot-wait poll interval during tunnel provision (adb getprop
# sys.boot_completed cadence inside the boot-timeout window). R7-wired:
# config.js now reads this (default 5000 — behavior-identical); fast hosts
# may lower it, loaded hosts may raise it.
REDROID_TUNNEL_POLL_MS=5000
# data-plane canary target (admin-set; required before any HEALTHY claim).
# Empty host + port 0 = canary NOT configured = devices can never be HEALTHY
# (fail-closed, MD §6.3). Use a resolvable host you control + a port serving
# a known body; the canary sends/compares a nonce.
REDROID_CANARY_HOST=
REDROID_CANARY_PORT=0
REDROID_CANARY_TIMEOUT_MS=10000
REDROID_CANARY_FAIL_THRESHOLD=2
# automatic recovery policy: exponential backoff + budget + single-flight lease.
REDROID_RECOVERY_BACKOFF_BASE_MS=15000
REDROID_RECOVERY_BACKOFF_MAX_MS=600000
REDROID_RECOVERY_MAX_RETRIES=3
REDROID_RECOVERY_LOCK_LEASE_MS=900000


# ---------------------------------------------------------------- BR-B3
# Batch container lifecycle (MD Phase 3 — lane A). The API owns the
# container lifecycle (the worker must never hold the Docker socket).
# Identity data volumes bind from BATCH_CONTAINER_DATA_ROOT (must match the
# B1 identity dataPath rows; default aligned with IDENTITY_DATA_ROOT_DEFAULT).
BATCH_CONTAINER_DATA_ROOT=/data/water_army/identities
# Admin image allowlist fallback (AppSetting 'batch.container_image_allowlist'
# WINS when set). JSON array of "image" strings or { image, privileged?,
# reason?, memoryBytes?, nanoCpus?, cmd? } objects, or comma-separated refs.
# privileged:true REQUIRES reason (MD §12). Garbage = hard fail at boot.
# NEITHER env nor AppSetting set = fail closed (IMAGE_ALLOWLIST_UNAVAILABLE).
BATCH_CONTAINER_ALLOWED_IMAGES=
# ADB host-port pool for the 127.0.0.1-only ADB bind (MD §5.2). 'start-end'.
BATCH_ADB_HOST_PORT_RANGE=16370-16419
# Port lease TTL (ms) — a lease outlives a crash; the next start's sweep +
# reconcile reclaim it.
BATCH_PORT_LEASE_TTL_MS=1800000
# Graceful stop timeout (seconds) before force.
BATCH_CONTAINER_STOP_TIMEOUT_SEC=10
# Container name prefix (docker-name-safe). br-b3- is the smoke prefix.
BATCH_CONTAINER_NAME_PREFIX=wa-batch-
# Boot health = app-layer ADB handshake wait (MD §8.2 — docker 'running' is
# NOT health). Total window / poll cadence / single-probe timeout (ms).
BATCH_CONTAINER_HEALTH_TIMEOUT_MS=60000
BATCH_CONTAINER_HEALTH_POLL_MS=1000
BATCH_CONTAINER_HEALTH_PROBE_TIMEOUT_MS=3000

# ---------------------------------------------------------------- BR worker
# Worker-side tuning (defaults in apps/worker/src/config.js; set only when
# scaling or troubleshooting). The compose `worker` service sources these.
# Health endpoint the worker serves (scratch/env-specific deploys: pick a
# FREE port — 3001 is the default and is reserved elsewhere on this host).
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3001
# API base URL the worker calls back to (container network: http://api:3000).
API_INTERNAL_URL=http://api:3000
# --- AI task lane ---
TASK_MAX_CONCURRENCY=4
TASK_DEFAULT_TIMEOUT_MS=120000
TASK_MAX_TIMEOUT_MS=900000
TASK_DEFAULT_ATTEMPTS=3
TASK_CANCEL_POLL_MS=1000
TASK_CONCURRENCY_DEFER_MS=15000
TASK_CONCURRENCY_MAX_DEFERS=10
# --- schedule reconcile (PG -> queue index rebuild cadence) ---
SCHEDULE_RECONCILE_INTERVAL_MS=300000
# --- batch lane (MD §11/§12) ---
BATCH_SCHEDULER_ENABLED=true
BATCH_SCHEDULER_INTERVAL_MS=5000
BATCH_HEARTBEAT_MS=10000
# Slot lease TTL (ms). MUST be >= 2 x BATCH_HEARTBEAT_MS (boot-validated).
BATCH_SLOT_TTL_MS=60000
BATCH_SLOT_WAIT_MS=15000
BATCH_MAX_SLOT_DEFERS=40
BATCH_CANCEL_POLL_MS=2000
BATCH_DEFAULT_TIMEOUT_MS=120000
# Log verbosity (api + worker): debug | info | warn | error (default:
# production=info / dev=debug for the API, info for the worker).
LOG_LEVEL=info
