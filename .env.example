# =============================================================================
# water_army — environment template (施工 MD §14)
# Copy to .env and replace ALL placeholders. Never commit .env.
#   cp .env.example .env
# Generate secrets:  openssl rand -hex 32   (64 hex chars)
# =============================================================================

# --- Runtime ---
NODE_ENV=production
# Host-local dev binds loopback only. Inside the compose network the api
# container must bind all interfaces because the web container proxies
# /api -> api:3000 (the host never exposes the api port).
APP_HOST=127.0.0.1
APP_PORT=3000
# Public origin of the web UI (used for CSRF/Origin allowlist).
APP_PUBLIC_URL=http://127.0.0.1:3012

# --- Secrets ---
# APP_ENCRYPTION_KEY: provider API key encryption (AES-256-GCM). The SAME key
# is passed to api + worker (the worker decrypts locally; keys never cross
# the queue). Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARS
# SESSION_SECRET: session token hashing / signing.
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
# WORKER_API_TOKEN: service identity for worker→API tool calls (>=32 chars).
# Must match in BOTH the api and worker compose env. Generate:
#   openssl rand -hex 32
WORKER_API_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARS

# --- Session ---
SESSION_TTL_HOURS=12
# Set true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- PostgreSQL (compose postgres service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_HEX_CHARS
POSTGRES_DB=water_army
# Inside compose: host is `postgres`. Host-local dev: point at your own instance.
DATABASE_URL=postgresql://app:REPLACE_WITH_RANDOM_32_HEX_CHARS@postgres:5432/water_army

# --- Redis / queue ---
REDIS_URL=redis://redis:6379

# --- Docker ---
# ONLY the api service mounts this socket (read-only). Worker/web never see it.
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Local dev without Docker: set to empty string to disable the Docker check
# (health/ready will report docker: disabled instead of down).
#DOCKER_SOCKET_PATH=
# gid of the host's docker group — the api container (USER node) needs it to
# rw the socket. Check with: stat -c %g /var/run/docker.sock
DOCKER_GROUP_ID=125

# --- Task defaults (施工 MD 附錄 A) ---
DEFAULT_TIMEZONE=Asia/Taipei
TASK_DEFAULT_TIMEOUT_MS=120000
TASK_MAX_TIMEOUT_MS=900000
TASK_DEFAULT_ATTEMPTS=3
TASK_MAX_CONCURRENCY=4
# P6 flag #5: concurrency_key mutual exclusion — a job whose definition shares
# a concurrency_key with an in-flight run defers (15s × 10 = 2.5 min max hold),
# then records a visible `skipped` run instead of running in parallel.
TASK_CONCURRENCY_DEFER_MS=15000
TASK_CONCURRENCY_MAX_DEFERS=10
# Default AI provider when POST /api/tasks/runs omits body.provider.
# 'mock' = built-in orchestratable mock; or a name from /api/providers.
AI_PROVIDER=mock
# Mock provider script: built-in name (default | tool-docker-list |
# tool-restart-approve | slow | fail-then-ok | fail-auth | empty),
# a file path, or inline JSON (see apps/worker/src/providers/mock.js).
AI_MOCK_SCRIPT=default
# Inside compose the worker reaches the api at http://api:3000.
API_INTERNAL_URL=http://api:3000

# --- Web container (static server + /api proxy) ---
WEB_PORT=3012
API_UPSTREAM=http://api:3000
